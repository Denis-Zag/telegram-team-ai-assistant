# Telegram
TELEGRAM_BOT_TOKEN=

# ProxyAPI в OpenAI-совместимом формате
PROXYAPI_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_CHAT_MODEL=openai/gpt-5-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=telegram-team-ai-assistant
PINECONE_NAMESPACE=team-chat
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Приложение
DATABASE_PATH=data/team_ai.db
RETRIEVAL_TOP_K=12
MAX_SUMMARY_MESSAGES=100
MAX_DOCUMENT_BYTES=10000000
LOG_LEVEL=INFO
